    "v1HeatFactors": {
      "type": "object",
      "properties": {
        "accessFrequency": {
          "type": "number",
          "format": "double",
          "description": "Fields 1-5 were never populated; heat is described by fields 6-8."
        },
        "interactionDepth": {
          "type": "number",
          "format": "double"
        },
        "recencyScore": {
          "type": "number",
          "format": "double"
        },
        "userEngagement": {
          "type": "number",
          "format": "double"
        },
        "topicImportance": {
          "type": "number",
          "format": "double"
        },
        "baseImportance": {
          "type": "number",
          "format": "double",
          "description": "Importance of the content: intrinsic importance plus contextual density, capped at 1."
        },
        "timeDecay": {
          "type": "number",
          "format": "double",
          "description": "Forgetting-curve factor in (0, 1]; 1 means just accessed."
        },
        "recallStrength": {
          "type": "number",
          "format": "double",
          "description": "Grows each time the memory is recalled, which slows decay."
        }
      },
      "description": "Heat follows the Ebbinghaus forgetting curve:\nheat = base_importance * time_decay, where time_decay = exp(-hours_since_access / (tau * recall_strength))."
    },
    "v1HeatMetrics": {
      "type": "object",
      "properties": {
        "overallHeat": {
          "type": "number",
          "format": "double",
          "description": "Mean current heat of the session's segments."
        },
        "breakdown": {
          "$ref": "#/definitions/v1HeatFactors",
          "description": "Mean of each heat factor across the session's segments."
        },
        "totalInteractions": {
          "type": "integer",
          "format": "int32",
          "description": "Number of events stored through the session."
        },
        "lastActivity": {
          "type": "string",
